{
  "manifest_version": 3,
  "name": "薪火自动接单助手 v0.1.38",
  "description": "自动接取薪火评论任务并完成 X 回复与核验。",
  "version": "0.1.38",
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  },
  "action": {
    "default_title": "薪火自动接单助手 v0.1.38",
    "default_icon": {
      "16": "src/assets/icons/icon16.png",
      "32": "src/assets/icons/icon32.png",
      "48": "src/assets/icons/icon48.png",
      "128": "src/assets/icons/icon128.png"
    }
  },
  "options_page": "src/debug/debug.html",
  "side_panel": {
    "default_path": "src/debug/debug.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://xinhuo123.com/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.xiaomimimo.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://xinhuo123.com/*"
      ],
      "js": [
        "src/content/xinhuo.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "src/content/x.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
